  ],
  "train_image_stride_max": 5,
  "train_image_stride_min": 1,
  "train_pair": [
    "DATA_ROOT/outdoor_day/outdoor_day1_left_events_6m.h5:D:/event-benchmark/data/mvsec_full_processed/outdoor_day/outdoor_day1_gt_flow_full.npz",
    "DATA_ROOT/outdoor_day/outdoor_day2_left_events_6m.h5:D:/event-benchmark/data/mvsec_full_processed/outdoor_day/outdoor_day2_gt_flow_full.npz"
  ],
  "training_objective": "self_supervised",
  "warmup_epochs": 0,
  "weight_decay": 0.0001
