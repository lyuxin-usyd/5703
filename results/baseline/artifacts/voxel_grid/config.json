  "lr": 0.0003,
  "lr_decay": 0.9,
  "lr_schedule": "evflownet",
  "metric_scope": "evflownet_official",
  "min_lr": 0.0,
  "model_batch_norm": true,
  "model_variant": "evflownet_multiscale",
  "paper_crop_size": 256,
