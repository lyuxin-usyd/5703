  "base_channels": 64,
  "batch_size": 8,
  "device": "cuda",
  "early_stop_min_delta": 0.001,
  "early_stop_patience": 10,
  "early_stop_val_strategy": "block-random",
  "early_stop_val_windows": 100,
  "epochs": 100,
  "eval_batch_size": 1,
  "eval_image_h5": [
    "DATA_ROOT/indoor_flying/indoor_flying1_left_images_full.h5",
    "DATA_ROOT/indoor_flying/indoor_flying2_left_images_full.h5",
    "DATA_ROOT/indoor_flying/indoor_flying3_left_images_full.h5"
  ],
  "eval_pair": [
    "DATA_ROOT/indoor_flying/indoor_flying1_left_events_6m.h5:D:/event-benchmark/data/mvsec_full_processed/indoor_flying/indoor_flying1_gt_flow_full.npz",
    "DATA_ROOT/indoor_flying/indoor_flying2_left_events_6m.h5:D:/event-benchmark/data/mvsec_full_processed/indoor_flying/indoor_flying2_gt_flow_full.npz",
    "DATA_ROOT/indoor_flying/indoor_flying3_left_events_6m.h5:D:/event-benchmark/data/mvsec_full_processed/indoor_flying/indoor_flying3_gt_flow_full.npz"
  ],
  "gradient_clip_norm": null,
  "image_scale": "raw255",
  "image_stride": 1,
